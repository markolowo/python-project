# .env.docker — переменные окружения для Docker Compose (критерий 3)
# ГЛАВНОЕ: адреса используют ИМЕНА СЕРВИСОВ из docker-compose.yml, а не localhost.
# Внутри Docker у каждого контейнера свой localhost; контейнеры находят друг друга по именам:
#   db    — контейнер PostgreSQL
#   redis — контейнер Redis

# Настройки, которые читает образ postgres при первом запуске (создаст пользователя и базу)
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_password
POSTGRES_DB=shop

# Адрес базы для приложения: postgresql+psycopg — PostgreSQL через драйвер psycopg 3; хост — db
DATABASE_URL=postgresql+psycopg://shop:shop_password@db:5432/shop
# Redis внутри Docker-сети — на стандартном порту 6379 (6380 — это только порт на компьютере)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Учебные значения для локального запуска. На настоящем сервере задаются свои, файл с ними в git не кладут
SECRET_KEY=docker-local-secret-change-me
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
