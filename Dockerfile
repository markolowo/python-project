# =====================================================================
# Dockerfile — РЕЦЕПТ ОБРАЗА ПРИЛОЖЕНИЯ (критерий 1)
# ---------------------------------------------------------------------
# Образ = Linux + Python + библиотеки + наш код. Один образ используется дважды
# в docker-compose.yml: для API (app) и для воркера Celery (worker) — меняется только команда.
# Сначала копируем requirements.txt и ставим библиотеки, ПОТОМ код: Docker кэширует слои,
# и при правке кода библиотеки не переустанавливаются — сборка идёт за секунды.
# =====================================================================

# Готовый образ с Python 3.14 на облегчённом Debian (slim)
FROM python:3.14-slim

# Не создавать файлы .pyc в контейнере
ENV PYTHONDONTWRITEBYTECODE=1
# Печатать логи сразу, без буфера — иначе docker compose logs показывал бы их с задержкой
ENV PYTHONUNBUFFERED=1

# Рабочая папка внутри контейнера
WORKDIR /code

COPY requirements.txt .
# --no-cache-dir — не хранить скачанные пакеты внутри образа (образ меньше)
RUN pip install --no-cache-dir -r requirements.txt

# Только папка приложения; тесты, .venv, базы не копируются (см. .dockerignore)
COPY app ./app

# Документирует, что приложение слушает порт 8000
EXPOSE 8000

# Команда запуска (требование: uvicorn с --host 0.0.0.0).
# 0.0.0.0 — принимать подключения «снаружи» контейнера. С 127.0.0.1 (как по умолчанию)
# приложение было бы доступно только изнутри самого контейнера, и с компьютера его не открыть.
# ${PORT:-8000} — порт из переменной PORT, а если её нет — 8000. Railway при деплое задаёт PORT сам.
# sh -c нужен, чтобы подставилась переменная ${PORT}
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
